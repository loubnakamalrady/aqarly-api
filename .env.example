# Copy to .env (which git ignores) and adjust if needed.
# `+psycopg` tells SQLAlchemy to use the psycopg 3 driver. These credentials
# match docker-compose.yml and are for local development only.
DATABASE_URL=postgresql+psycopg://aqarly:aqarly@localhost:5432/aqarly

# Optional. The frontend's seed JSON, read by scripts/seed.py. Defaults to
# ../aqarly/packages/core/data, the frontend repo checked out next to this one.
# FRONTEND_DATA_DIR=/path/to/aqarly/packages/core/data
